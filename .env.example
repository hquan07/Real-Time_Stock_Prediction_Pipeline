# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=stockdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=stock_raw_data

# Spark Master Configuration
SPARK_MASTER_HOST=localhost

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__RBAC=True
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:your_password_here@postgres:5432/stockdb
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Jupyter Configuration
JUPYTER_PORT=8888
JUPYTER_TOKEN=your_jupyter_token_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# CloudVault project client (keep the real token only in local .env/secrets)
CLOUDVAULT_BASE_URL=http://cloudvault-api
CLOUDVAULT_PROJECT_ID=real-time-stock
CLOUDVAULT_SERVICE_TOKEN=
CLOUDVAULT_CONNECT_TIMEOUT_SECONDS=5
CLOUDVAULT_READ_TIMEOUT_SECONDS=60
CLOUDVAULT_MAX_RETRIES=3
CLOUDVAULT_RETRY_BASE_SECONDS=0.5
CLOUDVAULT_MAX_FILE_BYTES=104857600
