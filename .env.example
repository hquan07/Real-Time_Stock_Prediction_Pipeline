# Database Configuration
PIPELINE_ENV=dev
IMAGE_TAG=dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stockdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-secret

# Kafka Configuration
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=stock_raw_data
# P1 opt-in profile uses market_price_raw, market_price_validated and
# market_price_dlq; the Registry is internal to Compose.

# Spark Master Configuration
SPARK_MASTER_HOST=spark-master

# Dashboard/Cache Configuration
DASHBOARD_PORT=5173
REDIS_HOST=redis
REDIS_PORT=6379
CORS_ALLOW_ORIGINS=http://localhost:5173

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__RBAC=True
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:your_password_here@postgres:5432/stockdb
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=replace-with-random-secret

# Jupyter Configuration
JUPYTER_PORT=8888
JUPYTER_TOKEN=replace-with-random-token
FINNHUB_API_KEY=

# CloudVault project client (keep the real token only in local .env/secrets)
CLOUDVAULT_BASE_URL=http://cloudvault-api
CLOUDVAULT_PROJECT_ID=real-time-stock
CLOUDVAULT_SERVICE_TOKEN=
CLOUDVAULT_CONNECT_TIMEOUT_SECONDS=5
CLOUDVAULT_READ_TIMEOUT_SECONDS=60
CLOUDVAULT_MAX_RETRIES=3
CLOUDVAULT_RETRY_BASE_SECONDS=0.5
CLOUDVAULT_MAX_FILE_BYTES=104857600
CLOUDVAULT_PUBLISH_ENABLED=false
CLOUDVAULT_MODEL_BUNDLE_MAX_BYTES=104857600
CLOUDVAULT_MODEL_TICKERS=ALL
CLOUDVAULT_MODEL_RETENTION_CLASS=model
# Optional validation gates. Leave empty until thresholds are approved.
CLOUDVAULT_MAX_TEST_RMSE=
CLOUDVAULT_MAX_TEST_MAE=
CLOUDVAULT_REPORT_PUBLISH_ENABLED=false
CLOUDVAULT_REPORT_RETENTION_CLASS=report
CLOUDVAULT_REPORT_EXPORT_DIR=/opt/airflow/artifacts/model-reports
